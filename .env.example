# =============================================================================
# Local development defaults. Copy to `.env` (git-ignored) and fill in the blanks.
# Production values live ONLY in the server's `.env` (see docs/PRODUCTION_DEPLOYMENT.md);
# the "PRODUCTION:" comments below show the intended production equivalents.
# =============================================================================

# Application
# PRODUCTION: NODE_ENV=production, PORT=3020, LOG_LEVEL=info
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# CORS: comma-separated list of allowed origins (a wildcard is rejected in production)
# PRODUCTION: CORS_ORIGINS=https://benuuprint.com,https://www.benuuprint.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Swagger UI at /api/docs (disable in production unless protected)
# PRODUCTION: SWAGGER_ENABLED=false
SWAGGER_ENABLED=true

# Set to true when running behind a reverse proxy (Caddy) so client IPs are read correctly
# (one trusted hop; also drives per-IP rate limiting). PRODUCTION: TRUST_PROXY=true
TRUST_PROXY=false

# Authentication. REQUIRED: generate with `openssl rand -base64 48` (min 32 chars)
JWT_ACCESS_SECRET=
# Optional dedicated key for customer-portal tokens (derived from JWT_ACCESS_SECRET when empty)
JWT_CUSTOMER_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# File storage (private; downloads use short-lived signed URLs)
# A relative root resolves against the process working directory; in production use an absolute,
# persistent path outside the repo/build tree. PRODUCTION: STORAGE_LOCAL_ROOT=/opt/benue-print/storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_MAX_FILE_BYTES=20971520
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Staff invitations / password reset
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60
# false = self-signup customers are active and can sign in immediately (no email verification).
# PRODUCTION (temporary, until email is configured): false. Switch to true later; no code change needed.
CUSTOMER_EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_HOURS=24
# Currency used when a quotation does not specify one (ISO 4217)
DEFAULT_CURRENCY=EGP
# Bulk-order release gate: an accepted quotation and this % of its total verified before
# an order can be READY_FOR_PRODUCTION (100 = full payment, 0 = no payment needed).
ORDER_REQUIRE_ACCEPTED_QUOTATION=true
ORDER_REQUIRED_PAID_PERCENT=100
# Public order-tracking requests per minute per IP
TRACKING_RATE_LIMIT_PER_MINUTE=30

# Phase 6A management intelligence. "Today" / "this week" / daily buckets use this IANA time zone
# (timestamps are always stored in UTC). Set it to the factory's local zone, e.g. Africa/Cairo.
BUSINESS_TIMEZONE=Africa/Cairo
# Defaults for date-range analytics (from/to); ranges are capped
MANAGEMENT_DEFAULT_RANGE_DAYS=30
MANAGEMENT_MAX_RANGE_DAYS=92
# "Due soon" window for staff workload, deadline window for Needs Attention, QC failure look-back
MANAGEMENT_DUE_SOON_HOURS=24
MANAGEMENT_DEADLINE_WINDOW_HOURS=48
MANAGEMENT_QC_LOOKBACK_HOURS=72
# ETA: history window and minimum completed samples before history beats the configured duration
ETA_HISTORY_DAYS=90
ETA_MIN_SAMPLES=5

# Phase 6B: notifications and scheduler (docs/PHASE_6B_AUTOMATION_OPERATIONAL_TOOLS.md)
# Providers: log (records / logs deliveries; development) | disabled (channel skipped; default in production).
# A real email / WhatsApp provider is plugged in behind the EmailProvider / WhatsAppProvider ports.
# PRODUCTION: EMAIL_PROVIDER=disabled, WHATSAPP_PROVIDER=disabled
# EMAIL_PROVIDER=log
# WHATSAPP_PROVIDER=log
EMAIL_FROM="Benue Print <no-reply@benue-print.local>"
NOTIFICATION_DEFAULT_LOCALE=en
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=3600
# Quiet hours in BUSINESS_TIMEZONE for external channels (empty = off); critical alerts bypass them
NOTIFICATION_QUIET_HOURS_START=21:00
NOTIFICATION_QUIET_HOURS_END=08:00
NOTIFICATION_QUIET_HOURS_APPLIES_TO=customer
# In-process scheduler (single node): outbox, delivery and alert evaluation intervals
# SCHEDULER_ENABLED=true
SCHEDULER_OUTBOX_INTERVAL_SECONDS=10
SCHEDULER_DISPATCH_INTERVAL_SECONDS=15
SCHEDULER_ALERTS_INTERVAL_SECONDS=300

# Frontend base URL used to build invitation / verification / tracking links (optional)
# PRODUCTION: PUBLIC_APP_URL=https://benuuprint.com
# PUBLIC_APP_URL=http://localhost:5173
# Return one-time tokens in admin responses (no email provider yet).
# Defaults to true outside production and false in production. PRODUCTION: keep false.
# EXPOSE_ONE_TIME_TOKENS=true

# Rate limiting (login/refresh are limited per IP per minute)
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
CUSTOMER_ACTION_RATE_LIMIT_PER_MINUTE=30

# Initial SUPER_ADMIN created by `pnpm db:seed` (only if no user with this email exists).
# Never commit real values. Leave the password blank to skip creating the account.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_PASSWORD=

# PostgreSQL (used by docker-compose.yml)
# PRODUCTION: POSTGRES_PORT=5545 (bound to 127.0.0.1 only; never expose PostgreSQL publicly)
POSTGRES_USER=benue
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=benue_print
POSTGRES_PORT=5433

# Host port for the containerised API (docker compose --profile app); unused with PM2.
# PRODUCTION (PM2): the app listens on PORT=3020 behind Caddy.
API_PORT=3000

# Prisma / application connection string
# PRODUCTION: postgresql://benue:CHANGE_ME@127.0.0.1:5545/benue_print?schema=public
DATABASE_URL=postgresql://benue:change_me_dev_only@localhost:5433/benue_print?schema=public
